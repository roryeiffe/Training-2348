<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
<!--        Database Connection:-->
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/hib</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">root</property>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>

        <!-- SQL Dialect: -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        
        <!-- DDL -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Show/Format SQL statements -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <property name="hibernate.cache.use_second_level_cache">true</property>
        <property name="hibernate.cache.region.factory_class">org.hibernate.cache.jcache.JCacheRegionFactory</property>

        <!-- Tell JCache/Ehcache which provider to use -->
        <property name="hibernate.javax.cache.provider">org.ehcache.jsr107.EhcacheCachingProvider</property>

        <!-- Optional: where your cache config lives -->
        <property name="hibernate.javax.cache.uri">classpath:ehcache.xml</property>

        <!-- We need this to be able to persiste Employee objects -->
        <mapping class="org.example.models.Employee"/>


    </session-factory>
</hibernate-configuration>